DOCKER_NAME=tin-staging
TIN_VERSION=dev-f292d16-tin.1

# Local staging: http://localhost:8087 (loopback only).
# For a Hetzner staging box behind Caddy: HOST_ADDRESS=staging.projects.tin.info, SECURE=true,
# and run with COMPOSE_PROFILES=https (needs the DNS record; requires approval).
HOST_ADDRESS=localhost:8087
SECURE=
HTTP_BIND=127.0.0.1
ACME_EMAIL=

# Leave MAIL_URL empty to skip email confirmation; set to http://mail:8097 with COMPOSE_PROFILES=mail.
MAIL_URL=
DISABLE_SIGNUP=false
